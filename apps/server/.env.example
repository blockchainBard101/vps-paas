# ─── Control Plane Server ──────────────────────────────────────────────
# Copy this file to `.env` (same folder) and adjust as needed.

# API port
PORT=4000

# Where ALL runtime data is stored (build workspaces, deployment logs,
# database backups and the auth/github/projects JSON stores).
# Leave EMPTY to default to ~/.railway-neon-paas (outside the repo).
# On a VPS point this at a persistent volume, e.g.:
# DATA_DIR=/var/lib/railway-neon-paas
DATA_DIR=

# Docker daemon socket
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Headless first-run admin bootstrap (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
INSTANCE_NAME=Production Cloud

# GitHub integration (optional)
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ─── Edge proxy (Caddy) ────────────────────────────────────────────────
# The control plane stores domain assignments and pushes the rendered config
# to Caddy's admin API. Point this at a Caddy instance that shares the
# `paas-internal-network` Docker network so it can reach service containers.
# If Caddy is unreachable the domains are still stored and shown in the UI.
CADDY_ADMIN_URL=http://localhost:2019
