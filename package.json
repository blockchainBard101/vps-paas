{
  "name": "railway-neon-paas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run start:dev --workspace=server",
    "build": "npm run build:server && npm run build:web",
    "build:web": "npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "start:prod": "./scripts/start.sh",
    "stop:prod": "./scripts/stop.sh",
    "update:prod": "./scripts/update.sh",
    "restart:prod": "pm2 restart ecosystem.config.cjs",
    "status:prod": "pm2 status",
    "logs:prod": "pm2 logs",
    "lint": "npm run lint --workspaces"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}
